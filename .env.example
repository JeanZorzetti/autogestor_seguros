# Mesma connection string do hub autogestor: os leads deste site caem nas
# MESMAS tabelas crm_leads/crm_eventos, no pipeline `seguro`, que o painel
# admin.autogestor.roilabs.com.br já lê. Não existe banco próprio deste site.
DATABASE_URL=postgres://usuario:senha@host:5432/autogestor

# Sai no canonical, no sitemap, no robots.txt e no llms.txt.
SITE_URL=https://seguros.roilabs.com.br
