---
export type Pergunta = { p: string; r: string };
interface Props {
  perguntas: readonly Pergunta[];
  titulo?: string;
}
const { perguntas, titulo = "Perguntas frequentes" } = Astro.props;
---

<section class="faq" aria-labelledby="faq-titulo">
  <h2 id="faq-titulo">{titulo}</h2>
  {/* <details>/<summary> nativo: teclado, estado anunciado e busca do
       navegador de graça, e o texto da resposta fica no HTML para o crawler
       mesmo com o item fechado. Um accordion em <div> custaria isso tudo. */}
  <div class="faq__lista">
    {
      perguntas.map((q) => (
        <details class="faq__item">
          <summary>{q.p}</summary>
          <div class="faq__resposta" set:html={q.r} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq__lista { display: grid; gap: 0; max-width: 78ch; align-items: start; border-top: 2px solid var(--fio-forte); }
  /* Acima de 900px, 78ch deixava ~430px vazios no container de 1120px. Duas
     colunas usam o espaço sem esticar a resposta além do confortável de ler.
     `gap: 0` nas duas: quem separa é a régua de 2px de cada item, e um vão
     entre eles quebraria a lista em cartões soltos — que é exatamente o que
     esta direção não tem. A coluna da direita ganha o fio à esquerda. */
  @media (min-width: 900px) {
    .faq__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: none; }
    .faq__item:nth-child(even) { border-left: 2px solid var(--fio-forte); }
  }
  /* Era cartão com borda de 1px, raio e fundo próprio. Agora é linha de lista:
     uma régua embaixo e nada mais. */
  .faq__item {
    border-bottom: 2px solid var(--fio-forte);
  }
  .faq__item summary {
    cursor: pointer;
    list-style: none;
    padding: var(--e-4);
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-base);
    letter-spacing: -0.005em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: 48px;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  /* O par de declarações não é engano: sem o texto alternativo (`/ ""`) o sinal
     entra no nome acessível e o leitor de tela anuncia "…corretora ou revenda?
     mais". A primeira linha é o que sobra em navegador que não suporta a
     sintaxe de alt — sem ela, o sinal sumiria e o item perderia a afordância. */
  .faq__item summary::after {
    content: "+";
    content: "+" / "";
    font-family: var(--display);
    font-size: var(--t-xl);
    line-height: 1;
    flex: none;
  }
  .faq__item[open] summary::after {
    content: "−";
    content: "−" / "";
  }
  /* Camada de ponteiro na escala do item: inverte, em 0ms. Nada de fundo
     levemente mais claro. */
  .faq__item summary:hover { background: var(--texto); color: var(--fundo); }
  .faq__resposta { padding: 0 var(--e-4) var(--e-4); color: var(--texto-suave); }
  /* O item aberto ganha o laranja da marca na lateral: é o único lugar do FAQ
     onde a cor aparece, e ela marca o estado em vez de decorar a lista. */
  .faq__item[open] { border-left: 2px solid var(--acento); }
</style>
