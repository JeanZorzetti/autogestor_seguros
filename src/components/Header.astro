---
import { ICONES } from "../data/solucoes";
import { EMPRESA, SITE, whatsapp } from "../consts";
import Logo from "./Logo.astro";

// SEM LINKS DE NAVEGAÇÃO, e a ausência é decisão da direção, não esquecimento.
// A macroestrutura desta página é ÍNDICE, e num índice quem carrega o mapa do
// site é a LISTA no rodapé — não uma barra repetida no topo de seis páginas.
// Das opções de nav do catálogo, esta é "só a marca, sem links": sobram o
// lockup e o telefone, que é a única ação que precisa estar visível o tempo
// todo numa página de captação. "Início" e "Quem somos" continuam existindo,
// agora no índice do rodapé, e as páginas internas ainda têm a trilha.
//
// O cabeçalho é INVERTIDO (`.inverso`): a página abre em tinta, o corpo é
// papel e o rodapé volta para tinta. Essa é a composição — tinta/papel/tinta —
// e é o que substitui as três superfícies empilhadas da direção anterior.
---

<header class="cabecalho inverso">
  <div class="container cabecalho__linha">
    {/* Lockup em duas linhas. A segunda linha é a CREDENCIAL: independência e
         ano de fundação, que é o que as peças impressas da própria Autogestor
         Seguros já trazem ("DESDE 2004", sob o wordmark). O número de registro
         SUSEP não repete aqui — vive só no rodapé, junto do link de consulta
         pública. O `aria-label` carrega as duas informações porque o leitor de
         tela anuncia o link inteiro de uma vez; o `aria-hidden` no texto evita
         que ele leia tudo duas vezes. */}
    <a href="/" class="marca" aria-label={`${SITE.nome} — ${SITE.selo} — página inicial`}>
      <Logo size={44} />
      <span class="marca__texto" aria-hidden="true">
        <span class="marca__nome">{SITE.nome}</span>
        <span class="marca__selo">{SITE.selo}</span>
      </span>
    </a>

    <a
      class="cabecalho__zap externo"
      href={whatsapp("Olá! Vim pelo site e quero cotar um seguro.")}
      target="_blank"
      rel="noopener"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={ICONES.zap}
      />
      {EMPRESA.telefoneExibicao}
      <span class="visualmente-oculto">— WhatsApp, abre em nova aba</span>
    </a>
  </div>
</header>

<style>
  .cabecalho {
    z-index: 20;
  }
  @media (min-width: 900px) {
    .cabecalho {
      position: sticky;
      top: 0;
    }
  }
  .cabecalho__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    padding-block: var(--e-3);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: var(--e-3);
    text-decoration: none;
    color: var(--texto);
  }
  /* O lockup é o único link da página que NÃO inverte no ponteiro: ele já está
     sobre tinta, e inverter aqui apagaria o símbolo junto com o texto. O que
     ele faz é o corte na direção contrária — o nome vira laranja. */
  .marca:hover,
  .marca:focus-visible {
    background: transparent;
    color: var(--texto);
  }
  .marca:hover .marca__nome,
  .marca:focus-visible .marca__nome {
    color: var(--acento);
  }
  .marca__texto {
    display: grid;
    gap: 2px;
  }
  .marca__nome {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-lg);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
  }
  /* 0.6875rem (11px): a 360px o lockup inteiro precisa caber ao lado do
     símbolo sem empurrar o WhatsApp para a linha de baixo. Abaixo disso a
     credencial deixa de ser lida, e credencial que ninguém lê não é prova. */
  .marca__selo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: var(--texto-suave);
    text-transform: uppercase;
  }

  /* Era pílula com fundo azul. Agora é o mesmo objeto do resto da direção: fio
     de 2px, canto reto, e no ponteiro ele INVERTE (papel cheio com o número em
     tinta) em vez de acender um cinza. */
  .cabecalho__zap {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-4);
    border: 2px solid var(--fio-forte);
    color: var(--texto);
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-sm);
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecalho__zap:hover,
  .cabecalho__zap:focus-visible {
    background: var(--texto);
    color: var(--fundo);
  }
</style>
