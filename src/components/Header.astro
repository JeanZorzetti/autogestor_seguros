---
import { ICONES } from "../data/solucoes";
import { EMPRESA, SITE, whatsapp } from "../consts";
import Logo from "./Logo.astro";

const { pathname } = Astro.url;
const atual = (href: string) => pathname === href || pathname === `${href}/`;

// Site de 1 vertical: 2 links fixos. O hub tem 6 verticais e precisa de rolagem
// horizontal na barra; aqui a lista cabe inteira em 360px, sem hambúrguer.
const NAV = [
  { href: "/", rotulo: "Início" },
  { href: "/sobre", rotulo: "Quem somos" },
];
---

<header class="cabecalho">
  <div class="container cabecalho__linha">
    {/* Lockup em duas linhas. A segunda linha NÃO é a divulgação de terceiro
         que o coopluz precisa fazer (lá o site fala de uma cooperativa que não
         é a Autogestor) — aqui não há terceiro. O que ocupa esse lugar é a
         CREDENCIAL: registro SUSEP e ano de fundação, que é o que muda a
         decisão de quem vai contratar seguro e é o que as peças impressas da
         própria Autogestor Seguros já trazem ("DESDE 2004", sob o wordmark).
         O `aria-label` carrega as duas informações porque o leitor de tela
         anuncia o link inteiro de uma vez; o `aria-hidden` no texto evita que
         ele leia tudo duas vezes. */}
    <a href="/" class="marca" aria-label={`${SITE.nome} — ${SITE.selo} — página inicial`}>
      <Logo size={44} />
      <span class="marca__texto" aria-hidden="true">
        <span class="marca__nome">{SITE.nome}</span>
        <span class="marca__selo">{SITE.selo}</span>
      </span>
    </a>

    <a
      class="cabecalho__zap externo"
      href={whatsapp("Olá! Vim pelo site e quero cotar um seguro.")}
      target="_blank"
      rel="noopener"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={ICONES.zap}
      />
      {EMPRESA.telefoneExibicao}
      <span class="visualmente-oculto">— WhatsApp, abre em nova aba</span>
    </a>

    <nav class="nav" aria-label="Navegação">
      <ul class="nav__lista" role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={atual(item.href) ? "page" : undefined}>
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    background: var(--superficie-alta);
    border-bottom: 1px solid var(--borda);
    z-index: 20;
  }
  @media (min-width: 900px) {
    .cabecalho {
      position: sticky;
      top: 0;
    }
  }
  .cabecalho__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    padding-block: var(--e-3);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: var(--e-3);
    text-decoration: none;
    color: var(--texto);
  }
  .marca__texto {
    display: grid;
    gap: 2px;
  }
  .marca__nome {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-lg);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
  }
  /* 0.6875rem (11px): a 360px o lockup inteiro precisa caber ao lado do
     símbolo sem empurrar o WhatsApp para a linha de baixo. Abaixo disso a
     credencial deixa de ser lida, e credencial que ninguém lê não é prova. */
  .marca__selo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: var(--texto-suave);
    text-transform: uppercase;
  }

  .cabecalho__zap {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-4);
    border-radius: var(--r-full);
    background: var(--azul-100);
    color: var(--marca-forte);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecalho__zap:hover {
    background: var(--cinza-100);
    color: var(--marca-forte);
  }

  /* 2 itens cabem numa linha mesmo a 360px. */
  .nav {
    flex-basis: 100%;
    border-top: 1px solid var(--borda);
    margin-inline: calc(-1 * var(--e-4));
    width: calc(100% + var(--e-8));
  }
  @media (min-width: 900px) {
    .nav {
      order: 2;
      flex-basis: auto;
      width: auto;
      margin-inline: 0;
      border-top: none;
    }
    .cabecalho__zap {
      order: 3;
    }
  }
  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-2);
    list-style: none;
    margin-block: 0;
    padding-inline: var(--e-4);
    padding-block: var(--e-1);
  }
  @media (min-width: 900px) {
    .nav__lista {
      padding: 0;
    }
  }
  .nav__lista a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--e-2) var(--e-3);
    border-radius: var(--r-2);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .nav__lista a:hover {
    background: var(--cinza-100);
    color: var(--texto);
  }
  /* A página atual é marcada por um traço da cor da marca, não só por cor de
     texto: cor sozinha não é sinal suficiente. O `aria-current` no HTML é o
     que carrega a informação para quem não vê o traço. */
  .nav__lista a[aria-current="page"] {
    color: var(--texto);
    background: var(--cinza-100);
    box-shadow: inset 0 -3px 0 var(--acento);
  }
</style>
