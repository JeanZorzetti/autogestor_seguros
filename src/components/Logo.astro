  class:list={["logo", klass]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={titulo ? "img" : "presentation"}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : "true"}
  focusable="false"
