  .veiculo__ficha {
    font-size: var(--t-sm);
    font-weight: 700;
  }

  /* --------------------------------------------------------- passos --- */
  .passos {
    display: grid;
    gap: var(--e-8);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }
  .passos li {
    counter-increment: passo;
  }
  /* O número do passo é decorativo e o `content` leva alternativa vazia: o
     leitor de tela já anuncia a posição pelo <ol>, e ouvir "1 Você manda nome"
     duplicaria a contagem. */
  .passos li::before {
    content: counter(passo);
    content: counter(passo) / "";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-full);
    background: var(--acento);
    color: var(--acento-texto);
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-lg);
    margin-bottom: var(--e-4);
  }
  .passos p {
    color: var(--texto-suave);
  }

  /* ----------------------------------------------------- fechamento --- */
  .fechamento {
    display: grid;
    gap: var(--e-8);
  }
  @media (min-width: 900px) {
    .fechamento {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--e-16);
      align-items: start;
    }
  }
