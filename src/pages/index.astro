       alcançável por teclado, do que espremer. */
    min-width: 640px;
    font-size: var(--t-sm);
  }
  .cmp th,
  .cmp td {
    padding: var(--e-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--borda);
  }
  .cmp tbody tr:last-child th,
  .cmp tbody tr:last-child td {
    border-bottom: 0;
  }
  .cmp thead th {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--texto);
