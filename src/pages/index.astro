---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import BarraAcao from "../components/BarraAcao.astro";
import { AREA_SERVIDA, ICONES, SEGURO } from "../data/solucoes";
import { ATENDIMENTO, EMPRESA, EXTERNOS, SEGURADORAS, SEGURADORAS_LOGO, SITE } from "../consts";

const site = Astro.site ?? new URL("https://seguros.roilabs.com.br");
const url = new URL("/", site).href;

// Contado da lista, nunca escrito à mão: o H1 promete um número e a faixa de
// prova mostra os nomes. Se alguém tirar uma companhia da lista e o H1 for
// literal, a página passa a mentir por um número.
const N = SEGURADORAS.length;

const veiculos = [
  { nome: "Carro", nota: "Novo, usado ou importado", icone: ICONES.carro, href: EXTERNOS.cotacaoVeiculo },
  { nome: "Moto", nota: "Qualquer cilindrada", icone: ICONES.moto, href: EXTERNOS.cotacaoMoto },
  { nome: "Caminhão", nota: "E frota, com gestão", icone: ICONES.caminhao, href: EXTERNOS.cotacaoCaminhao },
];

// A tabela da peça "TÁ NA DÚVIDA? SEGURO ou PROTEÇÃO VEICULAR?" (agosto/2026),
// com as linhas ALINHADAS por dimensão. A peça original lista as vantagens de
// cada lado em paralelo, sem correspondência — bom para o feed, ruim para
// decidir: sem a mesma pergunta feita aos dois lados, não é comparação, é
// dois anúncios lado a lado. E é a comparação que faz a corretora ganhar.
const comparacao = [
  {
    dimensao: "Quem fiscaliza",
    seguro: "Autarquia federal do setor de seguros (registro no rodapé).",
    protecao: "Ninguém. É associação civil, fora da regulação de seguros.",
  },
  {
    dimensao: "Garantia de que vai pagar",
    seguro: "A seguradora é obrigada por lei a manter reservas técnicas para as indenizações.",
    protecao: "Depende do rateio entre os associados no mês do evento.",
  },
  {
    dimensao: "O que você assina",
    seguro: "Apólice, com condições gerais registradas e prazo de vigência.",
    protecao: "Estatuto e regulamento interno, que a associação pode alterar em assembleia.",
  },
  {
    dimensao: "Como o custo se comporta",
    seguro: "Prêmio fechado na contratação e válido pela vigência inteira.",
    protecao: "Mensalidade menor, com possibilidade de rateio extraordinário.",
  },
  {
    dimensao: "Onde costuma compensar",
    seguro: "Perfil e veículo de boa aceitação no mercado.",
    protecao: "Veículo recusado, muito antigo, ou perfil com prêmio proibitivo.",
  },
];

const perguntas = [
  {
    p: "Qual a diferença entre seguro e proteção veicular?",
    r: "Seguro é contrato regulado por autarquia federal, com seguradora obrigada a manter reservas técnicas e indenização prevista em apólice. Proteção veicular é rateio entre associados de uma associação: costuma ser mais barata e <strong>não tem a mesma garantia regulatória</strong> — não é fiscalizada por esse regulador. Trabalhamos com as duas e dizemos qual é qual antes de você comparar preço, não depois do sinistro.",
  },
  {
    p: "Vocês representam uma seguradora só?",
    r: `Não. Somos corretora independente — o registro regulatório está no rodapé do site, com o link de verificação. Cotamos com ${N} companhias e apresentamos as opções lado a lado — prêmio, franquia, cobertura e o que ficou de fora. Se a proposta mais barata for a pior para o seu caso, a gente diz isso.`,
  },
  {
    p: "Quanto custa a cotação?",
    r: "Nada, e não há compromisso. A corretora é remunerada por comissão paga pela seguradora quando a apólice é emitida — o preço que você vê é o mesmo que veria indo direto na companhia. Cotar em várias ao mesmo tempo não deixa nenhuma delas mais cara.",
  },
  {
    p: "Dá para parcelar?",
    r: "Sim, em até 12x no cartão de crédito, e a maioria das companhias também aceita débito em conta ou boleto mensal. Quantas parcelas saem sem juros depende da seguradora e do prêmio, e o número exato aparece na proposta antes de você aceitar.",
  },
  {
    p: "O que a assistência 24h cobre?",
    r: "Guincho, chaveiro, troca de pneu, pane seca e transporte alternativo, com acionamento por 0800 em todo o território nacional. O limite de quilometragem do reboque varia por apólice e aparece na comparação — é uma das linhas em que as propostas mais se diferenciam.",
  },
  {
    p: "Uso o carro em aplicativo. Muda alguma coisa?",
    r: "Muda, e é importante declarar. Uso remunerado (aplicativo, táxi, locação) altera o risco e o prêmio, e omitir isso pode levar à recusa de indenização no sinistro. Por isso perguntamos a utilização já na cotação, e não depois.",
  },
  {
    p: "Quem cuida do sinistro depois?",
    r: "Nós. Abertura, acompanhamento da regulação e cobrança de prazo junto à seguradora fazem parte do serviço — é a razão de contratar com corretora em vez de comprar direto no site. Você não fica sozinho no 0800.",
  },
  {
    p: "Segura veículo importado ou já com muitos anos de uso?",
    r: "Sim: carro, moto, camionete e caminhão, nacionais ou importados, novos ou usados. Veículos mais antigos ou raros costumam ter menos companhias dispostas, e é justamente onde comparar várias vale mais — às vezes a diferença entre a primeira e a terceira proposta é de milhares de reais.",
  },
  {
    p: "Vocês atendem fora de Goiás?",
    r: `Sim. A sede é em ${EMPRESA.endereco.cidade}, mas as companhias com que trabalhamos operam em todo o país e o atendimento é por WhatsApp — a apólice não depende de você estar perto do escritório.`,
  },
];

const schema = [
  {
    "@type": "Service",
    "@id": `${url}#servico`,
    name: SEGURO.nome,
    description: SEGURO.descricao,
    url,
    serviceType: "Corretagem de seguro veicular",
    provider: { "@id": new URL("/#corretora", site).href },
    areaServed: AREA_SERVIDA[SEGURO.abrangencia],
    // Os quatro tipos de veículo como catálogo: é o que permite a um motor de
    // resposta dizer "atendem caminhão também" sem inventar.
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Seguro por tipo de veículo",
      itemListElement: ["Seguro de carro", "Seguro de moto", "Seguro de camionete", "Seguro de caminhão"].map((n) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: n },
      })),
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r.replace(/<[^>]+>/g, "") },
    })),
  },
];
---

<Base titulo={SEGURO.titulo} descricao={SEGURO.descricao} schema={schema} placa>
  {/* ---------------------------------------------------------- capa --- */}
  <section class="capa">
    <div class="container capa__grade">
      <div class="capa__texto">
        <span class="olho">Corretora independente · desde {EMPRESA.fundacao}</span>
        <h1>Seu seguro de carro, moto ou caminhão cotado em {N} seguradoras de uma vez</h1>
        <p class="chamada">
          Você preenche uma vez. A gente cota nas {N} companhias, coloca as propostas lado a lado e mostra o que
          cada apólice deixa de fora — inclusive quando a mais barata é a pior para o seu caso.
        </p>
        <ul class="lista-check capa__destaques" role="list">
          <li>Comparação entre companhias, não proposta de uma só</li>
          <li>Em até 12x no cartão, sem custo para cotar</li>
          <li>Assistência 24h nacional e acompanhamento do sinistro</li>
        </ul>

        {/* Atalho para quem já sabe o que quer: o formulário de 3 campos é o
             caminho curto, estes são as fichas completas da corretora. Fica
             abaixo dos destaques, não acima, para não competir com o CTA
             principal — mas existe, porque mandar quem já decidiu preencher
             três campos e esperar WhatsApp é fazê-lo esperar à toa. */}
        <p class="capa__atalho">
          Prefere preencher a ficha completa agora?
          {
            veiculos.map((v, i) => (
              <>
                {i > 0 ? " · " : " "}
                <a
                  class="externo"
                  href={v.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Cotação completa de seguro de ${v.nome.toLowerCase()} — site do parceiro, abre em nova aba`}
                >
                  {v.nome}
                </a>
              </>
            ))
          }
        </p>
      </div>

      <div class="capa__form">
        <LeadForm solucao={SEGURO} titulo="Peça sua cotação" instancia="topo" />
      </div>

      {/* ------------------------------------------------------- a placa ---
         O pé da primeira tela é a estrada. Recorte tratado da própria peça de
         captação da casa (logos/gerar-placa.py) — não é banco de imagem, e o
         raciocínio do recorte e da gradação está no docstring de lá.

         `aria-hidden` e `alt=""`: a placa é atmosfera, não informação. Tudo
         que ela mostra (carro, moto, camionete, caminhão) já está dito em
         texto na estação 03, e descrevê-la de novo faria o leitor de tela
         ouvir o catálogo duas vezes.

         DENTRO da grade, e não depois dela, apesar de sangrar de borda a
         borda. É o que faz o topo da placa nascer exatamente onde a coluna de
         texto termina — ver o bloco `a placa` no CSS, que explica por que as
         duas montagens anteriores (em fluxo depois da grade, e absoluta no pé
         da seção) foram descartadas com medição. */}
      <div class="capa__placa">
        {/* Um formato só, então `<img srcset>` e não `<picture>`: o AVIF saiu
             depois de medido (ver o cabeçalho de logos/gerar-placa.py — ele
             custava ~1,3s de LCP sob CPU estrangulada para economizar 7,5 KB),
             e `<picture>` com um `<source>` só é cerimônia sem função.

             `decoding="async"` porque foi o que mediu melhor, e o contrário do
             que a intuição diz para uma imagem LCP. Três variantes, 7 amostras
             cada, LCP mediano: async 1456ms · sync 1728ms · sem o atributo
             2148ms. As faixas se sobrepõem — a diferença entre as três é menor
             que o ruído da máquina —, então o que sustenta a escolha não é a
             mediana e sim o princípio: `sync` obriga o navegador a segurar a
             pintura até terminar de decodificar, e quem manda a imagem chegar
             cedo aqui é o `preload` + `fetchpriority` do <head>, não isto. */}
        <img
          src="/img/placa-1200.webp"
          srcset="/img/placa-600.webp 600w, /img/placa-1200.webp 1200w"
          sizes="100vw"
          width="1200"
          height="225"
          alt=""
          aria-hidden="true"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* --------------------------------------------- faixa de prova social ---
       O logotipo de cada companhia, não mais o nome em tipografia (peça do
       dono, 25/08/2026) — ver a ressalva de licença em SEGURADORAS_LOGO,
       consts.ts. Cada marca senta numa placa clara: as oito vieram desenhadas
       para fundo branco, e a maioria (Allianz #003781, HDI verde #006B2D)
       lê mal direto sobre o navy da página — a placa não é estética, é o
       fundo que cada marca já espera. */}
  <section class="prova" aria-labelledby="prova-titulo">
    <div class="container">
      <h2 id="prova-titulo" class="prova__titulo">
        Cotamos com {N} companhias do mercado
      </h2>
      <ul class="prova__lista lista-limpa" role="list">
        {
          SEGURADORAS.map((s) => (
            <li>
              <img src={`/img/seguradoras/${SEGURADORAS_LOGO[s]}`} alt={s} width="120" height="40" loading="lazy" />
            </li>
          ))
        }
      </ul>
      <p class="prova__nota">
        A disponibilidade de cada companhia varia por perfil, veículo e região — a comparação mostra quais
        aceitaram o seu caso.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------ estação 01 --- */}
  <section class="estacao">
    <div class="container estacao__grade">
      <header class="estacao__cabeca">
        <span class="estacao__n" aria-hidden="true">01</span>
        <span class="olho">Por que corretora</span>
        <h2>O site da seguradora só mostra a proposta dela</h2>
      </header>
      <div class="estacao__corpo">
        <p class="chamada">
          Cotar direto na companhia é rápido e devolve um preço. O que ele não devolve é a resposta que importa:
          esse preço é bom? Sem as outras {N} na mesma tela, não dá para saber.
        </p>
        <div class="grade grade--2">
          <div class="cartao">
            <h3>Antes de contratar</h3>
            <ul class="lista-check" role="list">
              <li>Cotação nas {N} companhias com o mesmo perfil, na mesma hora</li>
              <li>Análise de risco: uso do veículo, garagem, condutor jovem, região</li>
              <li>Franquia, carro reserva e vidros comparados linha a linha</li>
              <li>Leitura das exclusões — o que a apólice <em>não</em> cobre</li>
            </ul>
          </div>
          <div class="cartao">
            <h3>Depois de contratar</h3>
            <ul class="lista-check" role="list">
              <li>Abertura e acompanhamento do sinistro, por nossa conta</li>
              <li>Assistência 24h nacional por 0800</li>
              <li>Renovação com nova comparação de mercado, não renovação automática</li>
              <li>Troca de condutor, endereço e coberturas durante a vigência</li>
            </ul>
          </div>
        </div>
        <p class="estacao__nota">
          A corretagem é remunerada por comissão da seguradora quando a apólice sai. Você não paga para cotar, e o
          preço da apólice é o mesmo que teria indo direto na companhia.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ estação 02 --- */}
  <section class="estacao estacao--suave estacao--tabela">
    <div class="container estacao__grade">
      <header class="estacao__cabeca">
        <span class="estacao__n" aria-hidden="true">02</span>
        <span class="olho">Tá na dúvida?</span>
        <h2>Seguro ou proteção veicular</h2>
      </header>
      <div class="estacao__corpo">
        <p class="chamada">
          As duas coisas cobrem seu veículo e são <strong>juridicamente diferentes</strong>. A resposta depende do
          seu perfil — e escolher errado só aparece no dia do sinistro.
        </p>

        {/* Tabela de verdade, com `scope` nos cabeçalhos: numa comparação, quem
             usa leitor de tela precisa ouvir "Quem fiscaliza, Seguro: SUSEP", e
             isso só acontece com a relação célula/cabeçalho declarada.
             O `role="region"` + `tabindex="0"` existem porque a tabela rola na
             horizontal a 360px: container rolável sem foco é conteúdo que o
             teclado não alcança. */}
        <div class="tabela-rolagem" role="region" aria-labelledby="cmp-titulo" tabindex="0">
          <table class="cmp">
            <caption id="cmp-titulo" class="visualmente-oculto">
              Comparação entre seguro e proteção veicular, por dimensão
            </caption>
            <thead>
              <tr>
                <th scope="col">O quê</th>
                <th scope="col" class="cmp__seguro">Seguro <small>seguradoras</small></th>
                <th scope="col" class="cmp__protecao">Proteção veicular <small>associações</small></th>
              </tr>
            </thead>
            <tbody>
              {
                comparacao.map((l) => (
                  <tr>
                    <th scope="row">{l.dimensao}</th>
                    <td>{l.seguro}</td>
                    <td>{l.protecao}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="estacao__nota">
          Trabalhamos com as duas modalidades. A que a gente recomenda é a que protege melhor o seu caso, não a que
          paga melhor — e a diferença acima é dita antes da proposta, sempre.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ estação 03 --- */}
  <section class="estacao">
    <div class="container estacao__grade">
      <header class="estacao__cabeca">
        <span class="estacao__n" aria-hidden="true">03</span>
        <span class="olho">O que a gente cota</span>
        <h2>Carro, moto, camionete e caminhão</h2>
      </header>
      <div class="estacao__corpo">
        <ul class="veiculos lista-limpa" role="list">
          {
            veiculos.map((v) => (
              <li class="cartao veiculo">
                <svg
                  viewBox="0 0 24 24"
                  width="32"
                  height="32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={v.icone}
                />
                <h3>{v.nome}</h3>
                <p>{v.nota}</p>
                <a class="externo veiculo__ficha" href={v.href} target="_blank" rel="noopener">
                  Ficha completa
                  <span class="visualmente-oculto"> de {v.nome.toLowerCase()} — site do parceiro, abre em nova aba</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="estacao__nota">
          Camionete entra na mesma cotação de carro. Para frota, o atendimento é por WhatsApp — a ficha padrão não
          dá conta de mais de um veículo.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ estação 04 --- */}
  <section class="estacao estacao--suave">
    <div class="container estacao__grade">
      <header class="estacao__cabeca">
        <span class="estacao__n" aria-hidden="true">04</span>
        <span class="olho">Como funciona</span>
        <h2>Três campos e uma conversa</h2>
      </header>
      <div class="estacao__corpo">
        <ol class="passos" role="list">
          <li>
            <h3>Você manda nome, WhatsApp e o veículo</h3>
            <p>
              Só isso. Não pedimos CPF nem documento no formulário — o que falta a gente pergunta na conversa, e só
              o que a companhia realmente exige.
            </p>
          </li>
          <li>
            <h3>A gente cota nas {N} companhias</h3>
            <p>
              Mesmo perfil, mesmas coberturas, {N} propostas. Você recebe a comparação com prêmio, franquia, o que
              está incluso e o que ficou de fora, {ATENDIMENTO.prazo}.
            </p>
          </li>
          <li>
            <h3>Você escolhe e a apólice é emitida</h3>
            <p>
              Pagamento em até 12x no cartão, débito ou boleto. Depois disso, sinistro, alteração e renovação
              passam por nós — não pelo 0800.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- faq --- */}
  <section class="estacao">
    <div class="container">
      <Faq perguntas={perguntas} />
    </div>
  </section>

  {/* ------------------------------------------------------ fechamento --- */}
  <section class="estacao estacao--suave" id="pedir" tabindex="-1">
    <div class="container fechamento">
      <div>
        <span class="olho">Próximo passo</span>
        <h2>{SEGURO.fechamento}</h2>
        <p class="chamada">
          Um consultor da {SITE.nome} responde no seu WhatsApp {ATENDIMENTO.prazo}. Corretora independente desde
          {EMPRESA.fundacao}, com sede em {EMPRESA.endereco.cidade} e atendimento em todo o Brasil — o registro
          regulatório está no rodapé.
        </p>
      </div>
      <LeadForm solucao={SEGURO} titulo="Peça sua cotação" destaque instancia="fim" />
    </div>
  </section>

  <BarraAcao solucao={SEGURO} rotulo="Pedir cotação" />
</Base>

<style>
  /* ------------------------------------------------------------ capa ---
     Grade 6/5 assimétrica: o texto fica na coluna larga e o formulário na
     estreita, que é o suficiente para os três campos. Abaixo de 900px ele
     desce para baixo do texto e o botão sai da primeira tela — quem cobre
     esse trecho é a BarraAcao fixa, que existe exatamente até 899px.

     A proporção mudou de 5/7 para 6/5 e o comentário tinha ficado para trás;
     junto com ele estava a frase "o H1 condensado cabe em 3 linhas", que
     morreu quando a fonte de exibição deixou de ser condensada (25/08/2026,
     ver o bloco `--display` em global.css). Medido depois da troca: o botão
     de envio fica em y=589 numa janela de 900px. */
  /* ------------------------------------------- direção `asfalto` (capa) ---
     A capa deixa de ser fundo chapado e passa a ser NOITE COM CHÃO. Três
     camadas, e cada uma responde a um defeito medido na captura anterior:

       1. a placa       — o horizonte no pé da primeira tela. A página estava
                          abstrata: uma corretora de seguro VEICULAR sem um
                          único veículo em lugar nenhum.
       2. a luz da via  — um foco quente subindo do canto onde os faróis do
                          caminhão estão DENTRO da placa. É o que faz a foto
                          pertencer à página em vez de estar colada nela: sem
                          isso a costura entre o navy e a foto é visível por
                          mais suave que seja a máscara.
       3. o grão        — `--fundo` era `#050b14` sólido em 100% da área.

     O rastro (o gesto, em global.css) atravessa a placa por cima: ele é
     `position: fixed` com z-index 40 e a placa é conteúdo em fluxo. Não foi
     preciso código para conectar os dois — a linha de luz corta a estrada,
     que é exatamente a leitura que a direção quer. */
  .capa {
    position: relative;
    /* O pé da seção é a placa; o padding de baixo saiu com ela. */
    padding-block: var(--e-16) 0;
    /* A placa sangra com `width: 100vw`, e 100vw inclui a barra de rolagem em
       alguns navegadores. `clip` (não `hidden`) porque não há nada a rolar
       aqui: `hidden` criaria um contêiner de rolagem programática à toa. */
    overflow: hidden;
    overflow: clip;
    background:
      /* A LUZ DA VIA. Sobe do ponto onde os faróis do caminhão estão DENTRO da
         placa (direita, ~72% da largura), e é ela que faz a foto pertencer à
         página em vez de estar colada nela: sem esse foco a emenda entre o
         navy e o asfalto se vê por mais suave que seja a máscara.

         `at 72% 74%` e não `100%`: a primeira versão ancorava no pé da SEÇÃO,
         que depois da placa entrar na grade foi para y~1001 — abaixo da dobra
         numa janela de 900px. A luz existia e ninguém via. 74% cai logo acima
         do topo da placa nas larguras de desktop, que é de onde ela precisa
         sair para lavar a noite acima.

         Foco único e fora do centro, matiz único: dois focos simétricos em
         matizes opostos são o gradiente 'aurora' de landing de IA. */
      radial-gradient(
        72vw 52vh at 72% 74%,
        oklch(from var(--laranja-500) 0.62 c h / 0.2),
        transparent 64%
      ),
      linear-gradient(180deg, var(--capa-topo), var(--fundo) 70%);
  }
  /* `oklch(from …)` é recente. Sem ele o foco some e a costura aparece, então
     o valor literal vem antes e é sobrescrito por quem souber ler relativo —
     o hex é o --laranja-500 na luminância 0.62, calculado, não escolhido. */
  @supports not (color: oklch(from red l c h)) {
    .capa {
      background:
        radial-gradient(72vw 52vh at 72% 74%, rgba(214, 106, 26, 0.2), transparent 64%),
        linear-gradient(180deg, var(--capa-topo), var(--fundo) 70%);
    }
  }
  /* O grão fica ATRÁS do conteúdo (`::before` com z-index 0 e filhos em 1), e
     não por cima: soft-light a 5% sobre um parágrafo é imperceptível na
     captura e mesmo assim é uma camada de composição desenhada em cima de
     todo texto da primeira tela. Atrás, faz o mesmo trabalho de graça. */
  .capa::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--grao);
    opacity: 0.05;
    mix-blend-mode: soft-light;
  }
  .capa__grade {
    /* Acima do grão (0) e da placa (0). Explícito no seletor da grade, e não
       num `.capa > *`, para o empilhamento não depender da ordem das regras. */
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--e-12);
  }

  /* --------------------------------------------------------- a placa ---
     ITEM DA GRADE NA LINHA 2 DA COLUNA DE TEXTO, sangrando até as duas bordas
     e passando POR TRÁS do formulário. Foi a terceira montagem; as duas
     primeiras morreram na régua e ficam aqui porque a diferença entre elas é
     o motivo de esta existir:

       1ª · em fluxo, depois da grade. Não sobrepõe nada, mas a altura da
            placa SOMA à do formulário (~660px sozinho): numa janela de 900px
            sobravam 46px visíveis. Faixa de 46px não é horizonte, é borrão.
       2ª · absoluta no pé da seção. Impacto resolvido — e o piso quebrado: a
            linha `.capa__atalho` caía sobre o carro branco. Pior, o defeito
            MUDAVA com a largura: a 1440px o texto batia aos 27% da altura da
            placa, a 1100px aos 50% e a 900px aos 54%, onde a foto já está
            cheia. Máscara nenhuma resolve um alvo que se move — e afastar a
            placa devolvia a faixa de 46px da 1ª.

     Na grade, o topo da placa É o fim da coluna de texto, por construção e em
     qualquer largura. Não há número a acertar: o problema deixou de existir
     em vez de ser compensado.

     Dois ganhos vieram de brinde. O ar morto embaixo do texto (185px a 1440px,
     porque a seção só é alta por causa do formulário) vira estrada. E o cartão
     do formulário passa a ter chão em vez de vazio atrás — objeto apoiado lê
     como objeto, objeto sobre cor chapada lê como retângulo. */
  .capa__placa {
    position: relative;
    z-index: 0;
    height: clamp(11rem, 30vh, 22rem);
    /* Sangria de borda a borda de dentro do .container. O `overflow: clip` da
       .capa absorve o excesso de 100vw quando há barra de rolagem. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    /* Fallback COMPOSTO, não placeholder: se AVIF e WebP falharem os dois, o
       que sobra é um horizonte quente sob a máscara — a primeira tela continua
       tendo pé. Retângulo vazio aqui seria a tela parecendo inacabada. */
    background:
      linear-gradient(180deg, transparent 30%, oklch(from var(--laranja-700) 0.45 c h / 0.55) 82%, var(--noite-950)),
      var(--noite-900);
    /* O dissolvido do topo agora tem UM trabalho só, e é pequeno: costurar a
       borda de cima da foto no navy da página. Ele não protege texto nenhum —
       a grade já garante que não há texto por cima (ver acima) — então 30%
       bastam, contra os 68% que a montagem absoluta precisava. Mais estrada
       aparece por consequência da estrutura, não por afrouxar o piso.

       O corte do `cover` ajuda junto: a caixa é mais baixa que a proporção da
       foto, então os tetos cortados no recorte da peça ficam fora do quadro e
       não há emenda dura para esconder. */
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%);
    mask-image: linear-gradient(180deg, transparent, #000 30%);
  }
  /* 112% de altura com -6% de folga em cima e embaixo: é a margem que o
     deslize consome. Sem ela, o translado abriria um vão de fundo na borda. */
  .capa__placa img {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
    /* X — 62% e não centro: a 390px de largura a janela pega a camionete e os
       faróis do caminhão. Centralizada, sobra a lateral do carro branco —
       lataria sem farol, que é a metade sem luz da placa. (No desktop o eixo
       X não faz nada: a caixa é mais larga que a proporção da foto, então ela
       entra inteira na horizontal e o corte do `cover` é só vertical.)
       Y — 62% e não centro: puxa o enquadramento para o asfalto molhado e os
       reflexos, e joga para fora do quadro os tetos cortados no recorte. */
    object-position: 62% 62%;
  }

  /* A quarta camada: a estrada anda mais devagar que o texto. `view()` mede o
     próprio elemento cruzando a janela — zero JS, zero listener, mesma família
     do rastro. Amplitude de 4%: parallax que se nota é parallax que enjoa.

     ESTA CAMADA CHEGOU A SER CORTADA E VOLTOU, e o registro fica porque o erro
     é fácil de repetir. Ao investigar o LCP, uma medição apontou que sem o
     parallax a imagem deixava de ser o elemento de LCP (1636ms, elemento H1)
     e com ele passava a ser (2028ms, elemento IMG) — o que faria do parallax
     um custo de ~390ms por uma deriva de 4%.

     Era artefato: o script guardava o rótulo do elemento de UMA amostra, a
     última, e não de todas. Remedido com nove amostras rotuladas uma a uma, a
     imagem é o elemento de LCP em todas as configurações, com ou sem parallax,
     e a mediana fica em ~2100ms nas duas. O parallax não custa nada mensurável.

     Fica a regra, que vale para qualquer medição daqui: uma amostra não é
     medida, e rótulo de categoria (qual elemento, qual formato, qual arquivo)
     precisa ser colhido por amostra igual ao número. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .capa__placa img {
        animation: placa-desliza linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }
  @keyframes placa-desliza {
    from {
      transform: translateY(-4%);
    }
    to {
      transform: translateY(4%);
    }
  }
  @media (min-width: 900px) {
    .capa__grade {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--e-16);
      /* Vertical menor que a horizontal de propósito: a placa é o CHÃO do
         texto, não a próxima seção. 64px entre os dois abriria uma faixa de
         navy que faz a foto parecer colada embaixo. */
      row-gap: var(--e-8);
      align-items: start;
    }
    /* Colocação explícita, e é ela que resolve o problema inteiro (ver o bloco
       `a placa`): a placa fica na LINHA 2 e o formulário atravessa as duas.
       Assim a linha 1 tem a altura do texto — e só dela —, e o topo da placa
       cai exatamente no fim da coluna de texto em qualquer largura, sem
       nenhum número para acertar. */
    .capa__texto {
      grid-area: 1 / 1;
    }
    .capa__form {
      grid-area: 1 / 2 / span 2;
      /* Acima da placa, que passa por baixo dele. O cartão é opaco: é o que
         faz o formulário ficar apoiado na estrada em vez de recortá-la. */
      position: relative;
      z-index: 1;
    }
    .capa__placa {
      grid-area: 2 / 1 / auto / -1;
    }
  }
  .capa__destaques {
    margin-top: var(--e-6);
    font-weight: 600;
  }
  .capa__atalho {
    margin-top: var(--e-6);
    font-size: var(--t-sm);
    color: var(--texto-suave);
  }

  /* ------------------------------------------------ faixa de prova --- */
  .prova {
    background: var(--superficie);
    border-block: 1px solid var(--borda);
    padding-block: var(--e-8);
  }
  .prova__titulo {
    font-size: var(--t-sm);
    font-family: var(--corpo);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-bottom: var(--e-4);
  }
  /* `flex-wrap` e não grade de colunas fixas: os logotipos têm proporções
     muito diferentes ("HDI" quase quadrado contra o wordmark comprido da
     Bradesco Seguros) e uma grade regular deixaria buracos. */
  .prova__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    align-items: stretch;
  }
  /* A placa clara: cada logotipo foi desenhado para fundo branco, não para o
     navy da página (ver o comentário acima do <ul>). Altura fixa e `object-fit:
     contain` porque as oito chegam em proporções diferentes — a placa não
     pode esticar a marca de ninguém para preencher a caixa. */
  .prova__lista li {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding-inline: var(--e-4);
    background: var(--prata-050);
    border-radius: var(--r-3);
  }
  /* Largura e altura FIXAS, não `max-*` + `auto`: o SVG da Mapfre não declara
     `width`/`height` no elemento raiz (só `viewBox`), e nessa combinação o
     Chromium some com a caixa da imagem — mede 0×0 mesmo com o arquivo
     carregado (visto em `logos/_tmp-diag2.mjs` durante a verificação). Com
     dimensão definida o tamanho nunca depende do que cada arquivo declarou. */
  .prova__lista img {
    display: block;
    width: 108px;
    height: 28px;
    object-fit: contain;
  }
  .prova__nota {
    margin: var(--e-4) 0 0;
    font-size: var(--t-sm);
    color: var(--texto-suave);
    max-width: 72ch;
  }

  /* -------------------------------------------------------- estações --- */
  .estacao__nota {
    margin: var(--e-6) 0 0;
    font-size: var(--t-sm);
    color: var(--texto-suave);
    max-width: 72ch;
  }
  .estacao__corpo .grade {
    margin-top: var(--e-6);
  }
  .cartao h3 {
    margin-bottom: var(--e-4);
  }

  /* --------------------------------------------- tabela comparativa --- */
  .tabela-rolagem {
    margin-top: var(--e-8);
    overflow-x: auto;
    border: 1px solid var(--borda);
    border-radius: var(--r-4);
    background: var(--superficie-alta);
  }
  .cmp {
    border-collapse: collapse;
    width: 100%;
    /* Abaixo disto as três colunas viram uma palavra por linha e a comparação
